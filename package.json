{
  "name": "line-ai-ledger",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "db:local": "wrangler d1 execute line-ai-ledger --local --file=./schema.sql",
